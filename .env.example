# .env.example
# ─────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in values before running the app.
# Never commit .env to version control.
# ─────────────────────────────────────────────────────────────────

# University ID – must match a key in app/data/emergency_resources.json
UNIVERSITY_ID=default

# Log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# When True, raw student messages are never written to logs
REDACT_MESSAGE_TEXT=true

# Minimum ML classifier confidence required to influence routing (0.0 – 1.0)
ML_CONFIDENCE_THRESHOLD=0.65

# CORS origins (comma-separated). Use * for development only.
CORS_ORIGINS=*

# Google Gemini Free Tier API Key (from Google AI Studio, no credit card required)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
